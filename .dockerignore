# ---- never enter the image -------------------------------------------------

# git / editor / python caches
.git
**/.git
**/.git/
.gitignore
.gitmodules
.vscode
.venv_mp
.cache
.claude
**/__pycache__/
__pycache__/
*.pyc
*.pyo
*.pyd
**/.ipynb_checkpoints/
**/*.egg-info/

# logs
*.log

# secrets — Tencent Cloud credentials, MUST NOT ship
examples/SecretKey.csv

# run artifacts / outputs
output/
outputs/
pkl_outputs/
videos/
submit/
submit.rar
submit.zip

# optional SLAM (not imported by the streaming pipeline)
third-party/DPVO/

# ---- large files not needed at inference -----------------------------------

# DPVO SLAM weight (offline demo.py only)
checkpoints/dpvo.pth
# ViTPose-huge (2.5G) and YOLOv8x (136M) — the pipeline uses ViTPose-base + YOLOv8n
checkpoints/vitpose-h-multi-coco.pth
checkpoints/yolov8x.pt
checkpoints/yolov8s-pose.pt
# WHAM non-bedlam checkpoint (503M) — demo.yaml loads the bedlam variant; this one
# is only used by offline lib.eval.* benchmarks, never by the streaming pipeline.
checkpoints/wham_vit_w_3dpw.pth.tar

# SMPL-X -> SMPL conversion matrix (578M) — evaluation only, not the live pipeline
dataset/body_models/smplx2smpl.pkl
dataset/body_models/__MACOSX/
dataset/body_models/smpl/__MACOSX/

# large demo gif tracked via LFS
docs/video/

